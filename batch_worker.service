[Unit]
Description=Aleph70 Batch Worker
After=network.target

[Service]
User=sami
Group=www-data
WorkingDirectory=/var/www/html
Environment="PYTHONPATH=/var/www/html"
ExecStart=/var/www/html/venv/bin/python3 /var/www/html/scripts/batch_worker.py
Restart=always
RestartSec=10
StandardOutput=append:/var/www/html/logs/batch_worker.log
StandardError=append:/var/www/html/logs/batch_worker.log

[Install]
WantedBy=multi-user.target
